# ==========================================
# GUESSIHA - ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================
# Copy this file to .env before starting containers:
#   cp .env.example .env

# 1. Database Configuration (PostgreSQL + PostGIS)
POSTGRES_USER=geoguessr
POSTGRES_PASSWORD=choose_a_strong_database_password
POSTGRES_DB=geodb
POSTGRES_HOST=172.28.0.14
POSTGRES_PORT=5432

# 2. Redis In-Memory Bus
REDIS_HOST=172.28.0.15
REDIS_PORT=6379

# 3. Internal Cluster Security Secret
# Generate a random 32-character hex key (e.g., openssl rand -hex 16)
INTERNAL_CLUSTER_SECRET=choose_a_secure_random_cluster_secret_hex

# 4. Host Public IP or Domain
# Set to your AWS EC2 Public IPv4 or domain name (e.g. 54.210.12.34 or guessiha.com)
HOST_PRIMARY_IP=localhost

# 5. Public Web Port
# 80 for standard production HTTP (default), or 3000 for local dev
FRONTEND_PORT=80

# 6. External Street View & Maps APIs (Optional)
GOOGLE_API_KEY=

# 7. Telegram Feedback Bot (Optional)
# Get BOT_TOKEN from @BotFather, get CHAT_ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
